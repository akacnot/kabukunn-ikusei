rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownRedemptionId(redemptionId) {
      return signedIn() && redemptionId.matches('^[A-Z0-9_-]{3,32}_' + request.auth.uid + '$');
    }

    function validProfileCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'playerCode', 'nickname', 'iconId', 'coins', 'friendship', 'friends', 'migrationSource', 'migratedFromLocalAt', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.playerCode is string
        && request.resource.data.playerCode.matches('^[0-9]{12}$')
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.iconId is string
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.friendship is int
        && request.resource.data.friendship >= 1
        && request.resource.data.friends is list;
    }

    function validProfileUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'playerCode', 'nickname', 'iconId', 'coins', 'friendship', 'friends', 'migrationSource', 'migratedFromLocalAt', 'createdAt', 'updatedAt', 'role'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerCode == resource.data.playerCode
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.iconId is string
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= resource.data.coins + 100
        && request.resource.data.friendship is int
        && request.resource.data.friendship >= resource.data.friendship
        && request.resource.data.friendship <= resource.data.friendship + 10
        && request.resource.data.friends is list
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role);
    }

    function validFriendAcceptUpdate(uid) {
      return signedIn()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['friends', 'updatedAt'])
        && request.auth.uid in request.resource.data.friends
        && !(request.auth.uid in resource.data.friends)
        && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/friendRequests/$(uid + '_' + request.auth.uid)).data.status == 'pending';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid) || validFriendAcceptUpdate(uid);
      allow delete: if false;
    }

    match /playerCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[0-9]{12}$')
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.keys().hasOnly(['fromUid', 'fromCode', 'fromNickname', 'fromIconId', 'toUid', 'toCode', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.fromCode is string
        && request.resource.data.fromCode.matches('^[0-9]{12}$')
        && request.resource.data.toCode is string
        && request.resource.data.toCode.matches('^[0-9]{12}$')
        && request.resource.data.fromCode == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.playerCode
        && request.resource.data.toCode == get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.playerCode
        && !(request.resource.data.toUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends)
        && !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.friends)
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.auth.uid));

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.fromUid != request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved';

      allow delete: if false;
    }

    match /promoCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && code.matches('^[A-Z0-9_-]{3,32}$')
        && request.resource.data.keys().hasOnly(['label', 'rewards', 'usageLimit', 'usedCount', 'redeemedBy', 'enabled', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.label is string
        && request.resource.data.rewards.coins is int
        && request.resource.data.rewards.food is int
        && request.resource.data.usageLimit is int
        && request.resource.data.usageLimit >= 1
        && request.resource.data.usedCount == 0
        && request.resource.data.redeemedBy is list
        && request.resource.data.enabled is bool
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.enabled == true
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedCount', 'redeemedBy', 'updatedAt'])
          && resource.data.usedCount < resource.data.usageLimit
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.usageLimit == resource.data.usageLimit
          && request.resource.data.redeemedBy is list
          && request.auth.uid in request.resource.data.redeemedBy
          && !(request.auth.uid in resource.data.redeemedBy));

      allow delete: if isAdmin();
    }

    match /promoCodeRedemptions/{redemptionId} {
      allow get: if ownRedemptionId(redemptionId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'uid', 'rewards', 'redeemedAt'])
        && redemptionId == request.resource.data.code + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rewards.coins is int
        && request.resource.data.rewards.food is int
        && exists(/databases/$(database)/documents/promoCodes/$(request.resource.data.code));
      allow update, delete: if false;
    }
  }
}
